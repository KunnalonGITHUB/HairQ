# Firebase web app configuration. These values are safe for browser exposure.
# Obtain them from Firebase Console > Project settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional canonical public HairQ URL for strict origin checks behind a proxy.
# Set to the exact public origin per deployment; never a secret.
HAIRQ_APP_ORIGIN=

# Firebase Admin credentials: SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
# Use the same project as the web app. Supply secrets through .env.local or
# encrypted deployment environment settings, never a committed JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# A PEM private key; escaped \n sequences or actual line breaks are supported.
FIREBASE_PRIVATE_KEY=

# Optional local Firestore emulator only. Leave unset in Vercel/production.
# With this set, use a demo- FIREBASE_PROJECT_ID and no Admin credentials.
FIRESTORE_EMULATOR_HOST=
# Firebase Auth's reserved emulator variable is also blocked in production.
# Local server Auth emulation additionally requires the local Firestore emulator
# and a demo- project; leave FIREBASE_AUTH_EMULATOR_HOST unset for real Firebase.
FIREBASE_AUTH_EMULATOR_HOST=
# Browser connection for isolated development only. Leave unset in production.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=

# Existing Web Push settings. Preserve the current keypair when configuring.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
